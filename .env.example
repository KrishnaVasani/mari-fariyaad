# ===================================================================
# Mari-Fariyaad - Environment Variable Template
# Copy this file to `.env` (or export these as real environment
# variables) and fill in real values. NEVER commit real credentials.
# ===================================================================

# --- MySQL Database ---
DB_URL=jdbc:mysql://localhost:3306/marifariyaad_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change_me

# --- SMTP / Email (used to send Registration & Password Reset OTPs) ---
# For Gmail: create an "App Password" at https://myaccount.google.com/apppasswords
# (regular Gmail account passwords will NOT work with SMTP).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# --- File Upload Storage Directory ---
UPLOAD_DIR=uploads
